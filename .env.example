# Copy this file to ".env" and fill in your values. Never commit ".env".

# --- Groq (LLM) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Model name: check the current list at https://console.groq.com/docs/models
# (Groq retires models over time, so pick one that is currently listed.)
GROQ_MODEL=

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_DIR=./chroma_db
COLLECTION_NAME=documents

# --- Chunking (measured in characters) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=4

# --- Uploads ---
MAX_FILE_MB=20
